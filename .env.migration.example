# =============================================
# ClawHub MySQL 迁移配置
# =============================================

# MySQL 数据库
DATABASE_URL="mysql://root:password@localhost:3306/iclawstore"

# Meilisearch 搜索服务
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_master_key_here
MEILISEARCH_SEARCH_KEY=your_search_key_here

# Convex (数据源 - 用于导出)
CONVEX_DEPLOY_KEY=dev:your_convex_deployment|eyJ...
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# JWT 会话密钥
JWT_SECRET=generate_a_secure_random_string_here

# 文件存储
STORAGE_PATH=/www/wwwroot/iclawstore.com/storage

# GitHub OAuth (保留)
AUTH_GITHUB_ID=your_github_oauth_id
AUTH_GITHUB_SECRET=your_github_oauth_secret

# Google OAuth
AUTH_GOOGLE_ID=your_google_oauth_id
AUTH_GOOGLE_SECRET=your_google_oauth_secret

# 邮箱验证码 (Resend)
AUTH_RESEND_KEY=your_resend_api_key
AUTH_EMAIL_FROM="AI直聘 <no-reply@iclawstore.com>"

# 微信开放平台网站应用
AUTH_WECHAT_APP_ID=your_wechat_app_id
AUTH_WECHAT_APP_SECRET=your_wechat_app_secret
