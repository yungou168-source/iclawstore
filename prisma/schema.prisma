// Prisma Schema for ClawHub MySQL Migration
// Based on Convex schema.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Core Tables - User & Authentication
// ============================================

model users {
  id                        String    @id @default(cuid())
  name                      String?
  image                     String?
  email                     String?   @unique
  emailVerificationTime     DateTime?
  phone                     String?   @unique
  phoneVerificationTime     DateTime?
  isAnonymous               Boolean   @default(false)
  handle                    String?   @unique
  displayName               String?
  bio                       String?
  role                      String?   @default("user") // admin, moderator, user
  githubCreatedAt           DateTime?
  githubFetchedAt           DateTime?
  githubProfileSyncedAt     DateTime?
  trustedPublisher          Boolean   @default(false)
  publishedSkills           Int       @default(0)
  totalStars                Int       @default(0)
  totalDownloads            Int       @default(0)
  personalPublisherId       String?
  requiresModerationAt      DateTime?
  requiresModerationReason  String?
  deactivatedAt             DateTime?
  purgedAt                  DateTime?
  deletedAt                 DateTime?
  banReason                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  ownedSkills               skills[]         @relation("SkillOwner")
  ownedPublishers           publishers[]      @relation("PublisherOwner")
  publishedPackages         packages[]        @relation("PackageOwner")
  comments                  comments[]
  stars                     stars[]
  skillReports              skillReports[]
  skillAppeals              skillAppeals[]
  apiTokens                 apiTokens[]
  publisherMemberships      publisherMembers[]
  createdSkillVersions      skillVersions[]
  createdBadges             skillBadges[]

  @@index([handle])
  @@index([email])
  @@index([phone])
}

// ============================================
// Publisher (User/Org) Tables
// ============================================

model publishers {
  id                  String    @id @default(cuid())
  kind                String    @default("user") // user, org
  handle              String    @unique
  displayName         String
  bio                 String?
  image               String?
  linkedUserId        String?
  trustedPublisher    Boolean   @default(false)
  publishedSkills     Int       @default(0)
  publishedPackages   Int       @default(0)
  totalInstalls       Int       @default(0)
  totalDownloads      Int       @default(0)
  totalStars          Int       @default(0)
  skillTotalInstalls  Int       @default(0)
  skillTotalDownloads Int       @default(0)
  skillTotalStars     Int       @default(0)
  deactivatedAt       DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  owner               users?    @relation("PublisherOwner", fields: [linkedUserId], references: [id])
  members             publisherMembers[]
  skills              skills[]
  packages            packages[]
  officialPublishers   officialPublishers[]

  @@index([handle])
  @@index([linkedUserId])
  @@index([kind])
}

model publisherMembers {
  id          String   @id @default(cuid())
  publisherId String
  userId      String
  role        String   @default("publisher") // owner, admin, publisher
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisher   publishers @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  user        users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publisherId, userId])
  @@index([publisherId])
  @@index([userId])
}

model officialPublishers {
  id           String   @id @default(cuid())
  publisherId  String   @unique
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publisher    publishers @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publisherId])
}

// ============================================
// Skills Tables
// ============================================

model skills {
  id                       String    @id @default(cuid())
  slug                     String
  displayName              String
  summary                  String?
  icon                     String?
  resourceId               String?
  ownerUserId              String
  ownerPublisherId         String?
  canonicalSkillId         String?
  forkOfSkillId            String?
  forkOfKind               String?   // fork, duplicate
  forkOfVersion            String?
  forkOfAt                 DateTime?
  installKind              String?   // github
  githubSourceId           String?
  githubPath               String?
  githubHasSkillCard       Boolean?
  githubCurrentCommit      String?
  githubCurrentContentHash String?
  githubCurrentStatus      String?   // present, missing, unknown
  githubCurrentCheckedAt   DateTime?
  githubScanStatus         String?   // clean, suspicious, malicious, pending, failed
  githubRemovedAt          DateTime?
  latestVersionId          String?
  latestVersionSummary     Json?
  tags                     Json?
  capabilityTags           Json?     // Array of strings stored as JSON
  softDeletedAt            DateTime?
  moderationStatus         String?   // active, hidden, removed
  moderationNotes          String?
  moderationReason         String?
  moderationVerdict        String?   // clean, suspicious, malicious
  moderationReasonCodes    Json?     // Array of strings stored as JSON
  moderationEvidence       Json?
  moderationSummary        String?
  moderationEngineVersion  String?
  moderationEvaluatedAt    DateTime?
  manualOverride           Json?
  quality                  Json?
  isSuspicious             Boolean?
  moderationFlags          Json?     // Array of strings stored as JSON
  lastReviewedAt           DateTime?
  scanLastCheckedAt        DateTime?
  scanCheckCount           Int?
  hiddenAt                 DateTime?
  hiddenBy                 String?
  unpublishedSlugReservedUntil DateTime?
  unpublishedSlugReleasedAt     DateTime?
  unpublishedOriginalSlug       String?
  reportCount              Int       @default(0)
  lastReportedAt           DateTime?
  batch                    String?
  
  // Stats (canonical fields)
  statsDownloads           Int       @default(0)
  statsStars               Int       @default(0)
  statsInstallsCurrent     Int       @default(0)
  statsInstallsAllTime     Int       @default(0)
  statsVersions            Int       @default(0)
  statsComments            Int       @default(0)
  
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  owner                    users      @relation("SkillOwner", fields: [ownerUserId], references: [id])
  publisher                publishers? @relation(fields: [ownerPublisherId], references: [id])
  canonicalSkill           skills?     @relation("SkillCanonical", fields: [canonicalSkillId], references: [id])
  forks                    skills[]    @relation("SkillCanonical")
  versions                 skillVersions[]
  comments                 comments[]
  stars                    stars[]
  skillBadges              skillBadges[]
  skillReports             skillReports[]
  skillAppeals             skillAppeals[]
  skillEmbeddings          skillEmbeddings[]
  dailyStats               skillDailyStats[]
  statEvents               skillStatEvents[]

  @@unique([ownerUserId, slug])
  @@index([ownerPublisherId])
  @@index([slug])
  @@index([statsDownloads])
  @@index([statsStars])
  @@index([statsInstallsAllTime])
  @@index([softDeletedAt])
  @@index([moderationStatus])
}

model skillVersions {
  id                       String    @id @default(cuid())
  skillId                  String
  version                  String
  fingerprint              String?
  sourceProvenance         Json?
  changelog                String    @default("")
  changelogSource          String?   // auto, user
  icon                     String?
  files                    Json      // Array of file objects
  parsed                   Json
  createdBy                String
  createdAt                DateTime  @default(now())
  clawScanNote             String?
  clawScanNoteUpdatedAt    DateTime?
  softDeletedAt            DateTime?
  sha256hash               String?
  vtAnalysis               Json?
  skillSpectorAnalysis     Json?
  llmAnalysis              Json?
  capabilityTags           Json?     // Array of strings stored as JSON
  depRegistryAnalysis      Json?
  depRegistryScanStatus    String?
  staticScan               Json?
  apiKeyRequired           Boolean?

  // Relations
  skill                    skills    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  creator                  users      @relation(fields: [createdBy], references: [id])

  @@unique([skillId, version])
  @@index([skillId])
  @@index([sha256hash])
}

model skillEmbeddings {
  id                 String   @id @default(cuid())
  skillId            String
  versionId          String
  ownerId            String
  ownerPublisherId   String?
  embedding          Json     // Array of floats stored as JSON
  isLatest           Boolean  @default(true)
  isApproved         Boolean  @default(true)
  visibility         String   @default("public")
  updatedAt          DateTime @updatedAt

  // Relations
  skill              skills   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([versionId])
}

model skillBadges {
  id       String   @id @default(cuid())
  skillId  String
  kind     String   // highlighted, official, deprecated, redactionApproved
  byUserId String
  at       DateTime @default(now())

  skill    skills   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user     users    @relation(fields: [byUserId], references: [id])

  @@unique([skillId, kind])
  @@index([skillId])
  @@index([kind])
}

// ============================================
// Comments & Stars
// ============================================

model comments {
  id                   String    @id @default(cuid())
  skillId              String
  userId               String
  body                 String
  reportCount          Int       @default(0)
  lastReportedAt       DateTime?
  scamScanVerdict      String?   // not_scam, likely_scam, certain_scam
  scamScanConfidence   String?   // low, medium, high
  scamScanExplanation  String?
  scamScanEvidence     Json?     // Array of strings stored as JSON
  scamScanModel        String?
  scamScanCheckedAt    DateTime?
  scamBanTriggeredAt   DateTime?
  createdAt            DateTime  @default(now())
  softDeletedAt        DateTime?
  deletedBy            String?

  skill                skills    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user                 users     @relation(fields: [userId], references: [id])
  reports              commentReports[]

  @@index([skillId])
  @@index([userId])
}

model commentReports {
  id        String   @id @default(cuid())
  commentId String
  skillId   String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  comment   comments @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([skillId])
  @@index([userId])
}

model stars {
  id        String   @id @default(cuid())
  skillId   String
  userId    String
  createdAt DateTime @default(now())

  skill     skills   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([skillId, userId])
  @@index([skillId])
  @@index([userId])
}

// ============================================
// Reports & Appeals
// ============================================

model skillReports {
  id            String    @id @default(cuid())
  skillId       String
  skillVersionId String?
  version       String?
  userId        String
  reason        String?
  status        String?    @default("open") // open, confirmed, dismissed, triaged
  triagedAt     DateTime?
  triagedBy     String?
  triageNote    String?
  actionTaken   String?   // none, hide
  createdAt     DateTime  @default(now())

  skill         skills    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  reporter      users     @relation(fields: [userId], references: [id])

  @@index([skillId])
  @@index([userId])
  @@index([status])
}

model skillAppeals {
  id            String    @id @default(cuid())
  skillId       String
  skillVersionId String?
  version       String?
  userId        String
  message       String
  status        String    @default("open") // open, accepted, rejected
  resolvedAt    DateTime?
  resolvedBy    String?
  resolutionNote String?
  actionTaken   String?   // none, restore
  createdAt     DateTime  @default(now())

  skill         skills    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user          users     @relation(fields: [userId], references: [id])

  @@index([skillId])
  @@index([userId])
  @@index([status])
}

// ============================================
// Packages (OpenClaw)
// ============================================

model packages {
  id                    String    @id @default(cuid())
  name                  String
  normalizedName        String    @unique
  displayName           String
  summary               String?
  ownerUserId           String
  ownerPublisherId      String?
  family                String    @default("skill") // skill, code-plugin, bundle-plugin
  channel               String    @default("community") // official, community, private
  isOfficial            Boolean   @default(false)
  runtimeId             String?
  sourceRepo            String?
  latestReleaseId       String?
  latestVersionSummary  Json?
  tags                  Json?
  capabilityTags        Json?     // Array of strings stored as JSON
  executesCode          Boolean?
  compatibility         Json?
  capabilities          Json?
  verification          Json?
  scanStatus            String    @default("pending") // clean, suspicious, malicious, pending, not-run
  stats                 Json
  reportCount           Int       @default(0)
  lastReportedAt        DateTime?
  softDeletedAt         DateTime?
  softDeletedReason     String?
  softDeletedBy         String?
  softDeletedByRole     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner                 users      @relation("PackageOwner", fields: [ownerUserId], references: [id])
  publisher             publishers? @relation(fields: [ownerPublisherId], references: [id])
  releases              packageReleases[]

  @@index([normalizedName])
  @@index([ownerUserId])
  @@index([ownerPublisherId])
  @@index([family])
  @@index([channel])
}

model packageReleases {
  id                      String    @id @default(cuid())
  packageId               String
  version                 String
  changelog               String    @default("")
  summary                 String?
  distTags                Json?     // Array of strings stored as JSON
  files                   Json
  integritySha256         String
  artifactKind            String?   // legacy-zip, npm-pack
  clawpackStorageId       String?
  clawpackSha256          String?
  clawpackSize            Int?
  clawpackFormat          String?
  npmIntegrity            String?
  npmShasum               String?
  npmTarballName          String?
  npmUnpackedSize         Int?
  npmFileCount            Int?
  extractedPackageJson    Json?
  extractedPluginManifest Json?
  normalizedBundleManifest Json?
  compatibility           Json?
  capabilities            Json?
  runtimeId               String?
  sourceRepo              String?
  verification            Json?
  sha256hash              String?
  vtAnalysis              Json?
  skillSpectorAnalysis     Json?
  llmAnalysis             Json?
  staticScan              Json?
  manualModeration        Json?
  source                  Json?
  createdBy               String
  publishActor            Json
  createdAt               DateTime  @default(now())
  clawScanNote            String?
  clawScanNoteUpdatedAt   DateTime?
  softDeletedAt           DateTime?

  package                 packages  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, version])
  @@index([packageId])
}

// ============================================
// Stats & Events
// ============================================

model skillDailyStats {
  id        String   @id @default(cuid())
  skillId   String
  day       DateTime @db.Date
  downloads Int      @default(0)
  installs  Int      @default(0)
  updatedAt DateTime @updatedAt

  skill     skills   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, day])
  @@index([day])
}

model skillStatEvents {
  id          String    @id @default(cuid())
  skillId     String
  kind        String    // download, star, unstar, comment, uncomment, install_new, etc.
  delta       Json?
  occurredAt  DateTime  @default(now())
  processedAt DateTime?

  skill       skills    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([processedAt])
  @@index([skillId])
}

model globalStats {
  id                 String   @id @default(cuid())
  key                String   @unique
  activeSkillsCount  Int      @default(0)
  updatedAt          DateTime @updatedAt
}

// ============================================
// API Tokens
// ============================================

model apiTokens {
  id          String    @id @default(cuid())
  userId      String
  label       String
  prefix      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  user        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// Rate Limiting
// ============================================

model rateLimits {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  shard       Int?
  count       Int      @default(0)
  limit       Int
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

// ============================================
// Reserved Slugs & Handles
// ============================================

model reservedSlugs {
  id                  String   @id @default(cuid())
  slug                String   @unique
  originalOwnerUserId String
  deletedAt           DateTime @default(now())
  expiresAt           DateTime
  reason              String?
  releasedAt          DateTime?

  @@index([slug])
  @@index([expiresAt])
}

model reservedHandles {
  id                  String   @id @default(cuid())
  handle              String   @unique
  rightfulOwnerUserId String
  reason              String?
  releasedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([handle])
}

// ============================================
// Audit Logs
// ============================================

model auditLogs {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

// ============================================
// AI Direct Hiring — MySQL source of truth
// ============================================

// P0: Model Catalog, Agents, Versions, Run Audits, Credentials, Organizations
model aiDirectModelCatalog {
  id              String   @id @db.VarChar(36)
  modelKey        String   @unique @db.VarChar(255)
  displayName     String   @db.VarChar(255)
  status          String   @default("draft") @db.VarChar(32)
  capabilities    Json?
  taskProfile     Json?
  evidenceVersion String?  @db.VarChar(128)
  evidence        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("ai_direct_model_catalog")
}

model aiDirectAgents {
  id               String   @id @db.VarChar(36)
  ownerUserId      String   @db.VarChar(191)
  ownerPublisherId String?  @db.VarChar(191)
  name             String   @db.VarChar(120)
  description      String?  @db.Text
  status           String   @default("draft") @db.VarChar(32)
  activeVersionId  String?  @db.VarChar(36)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerUserId])
  @@index([ownerPublisherId])
  @@map("ai_direct_agents")
}

model aiDirectAgentVersions {
  id              String   @id @db.VarChar(36)
  agentId         String   @db.VarChar(36)
  version         Int
  status          String   @default("draft") @db.VarChar(32)
  promptSpec      Json
  modelPolicy     Json
  executionPolicy Json
  createdByUserId String   @db.VarChar(191)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([agentId, version])
  @@index([agentId])
  @@map("ai_direct_agent_versions")
}

model aiDirectModelRunAudits {
  id              String   @id @db.VarChar(36)
  agentId         String   @db.VarChar(36)
  agentVersionId  String   @db.VarChar(36)
  catalogModelId  String   @db.VarChar(36)
  modelKey        String   @db.VarChar(255)
  taskType        String?  @db.VarChar(128)
  status          String   @db.VarChar(32)
  failureCode     String?  @db.VarChar(128)
  inputTokens     Int?
  outputTokens    Int?
  costMicros      BigInt?
  latencyMs       Int?
  routingMetadata Json
  createdAt       DateTime @default(now())

  @@index([agentId, createdAt])
  @@map("ai_direct_model_run_audits")
}

model aiDirectUserCredentials {
  id         String   @id @db.VarChar(36)
  userId     String   @db.VarChar(191)
  provider   String   @default("jinsha-token") @db.VarChar(64)
  cipherText String   @db.MediumText
  iv         String   @db.VarChar(64)
  authTag    String   @db.VarChar(64)
  keyVersion String   @default("v1") @db.VarChar(32)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  revokedAt  DateTime?

  @@unique([userId, provider])
  @@index([userId])
  @@map("ai_direct_user_credentials")
}

model aiDirectOrganizations {
  id                     String   @id @db.VarChar(36)
  name                   String   @db.VarChar(160)
  slug                   String   @unique @db.VarChar(160)
  ownerUserId            String   @db.VarChar(191)
  idempotencyKey         String?  @db.VarChar(128)
  idempotencyFingerprint String?  @db.Char(64)
  status                 String   @default("active") @db.VarChar(32)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId])
  @@index([status, updatedAt])
  @@map("ai_direct_organizations")
}

model aiDirectOrganizationMembers {
  id              String   @id @db.VarChar(36)
  organizationId  String   @db.VarChar(36)
  userId          String   @db.VarChar(191)
  role            String   @default("member") @db.VarChar(32)
  status          String   @default("active") @db.VarChar(32)
  createdByUserId String   @db.VarChar(191)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("ai_direct_organization_members")
}

model aiDirectAuditEvents {
  id             String   @id @db.VarChar(36)
  organizationId String?  @db.VarChar(36)
  actorUserId    String?  @db.VarChar(191)
  action         String   @db.VarChar(128)
  targetType     String   @db.VarChar(64)
  targetId       String   @db.VarChar(191)
  requestId      String?  @db.VarChar(128)
  outcome        String   @db.VarChar(32)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("ai_direct_audit_events")
}

model aiDirectOutboxEvents {
  id             String    @id @db.VarChar(36)
  organizationId String?   @db.VarChar(36)
  aggregateType  String    @db.VarChar(64)
  aggregateId    String    @db.VarChar(191)
  eventType      String    @db.VarChar(128)
  payloadVersion Int       @default(1)
  payload        Json
  occurredAt     DateTime  @default(now())
  status         String    @default("pending") @db.VarChar(32)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  publishedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?   @db.Text

  @@index([status, availableAt])
  @@index([publishedAt, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("ai_direct_outbox_events")
}

// P1: Companies, Projects, AgentRoles, CapabilityGrants, Offers, Employments, Approvals, WorkflowRuns
model aiDirectCompanies {
  id               String   @id @default(cuid())
  organizationId   String   @db.VarChar(36)
  name             String   @db.VarChar(160)
  slug             String   @unique @db.VarChar(160)
  status           String   @default("active") @db.VarChar(32)
  createdByUserId  String   @db.VarChar(191)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@map("ai_direct_companies")
}

model aiDirectProjects {
  id                 String   @id @default(cuid())
  companyId          String   @db.VarChar(36)
  name               String   @db.VarChar(160)
  slug               String   @db.VarChar(160)
  status             String   @default("active") @db.VarChar(32)
  budgetMicros       BigInt?  @default(0)
  sensitivityLimit   String?  @db.VarChar(64)
  createdByUserId    String   @db.VarChar(191)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, status, updatedAt])
  @@map("ai_direct_projects")
}

model aiDirectAgentRoles {
  id                    String   @id @default(cuid())
  companyId             String   @db.VarChar(36)
  projectId             String?  @db.VarChar(36)
  name                  String   @db.VarChar(160)
  responsibilities      Json
  requiredCapabilities  Json
  budgetMicros          BigInt?  @default(0)
  status                String   @default("open") @db.VarChar(32)
  createdByUserId       String   @db.VarChar(191)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId, status, updatedAt])
  @@index([projectId, status])
  @@map("ai_direct_agent_roles")
}

model aiDirectCapabilityGrants {
  id               String    @id @default(cuid())
  subjectType      String    @db.VarChar(32)
  subjectId        String    @db.VarChar(191)
  resourceType     String    @db.VarChar(64)
  resourceId       String    @db.VarChar(191)
  action           String    @db.VarChar(64)
  scope            Json?
  issuedByUserId   String    @db.VarChar(191)
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?   @db.VarChar(191)
  revokeReason     String?   @db.Text

  @@index([subjectType, subjectId, resourceType, resourceId, revokedAt])
  @@index([resourceType, resourceId, revokedAt])
  @@index([revokedAt])
  @@map("ai_direct_capability_grants")
}

model aiDirectOffers {
  id               String    @id @default(cuid())
  roleId           String    @db.VarChar(36)
  agentVersionId   String    @db.VarChar(36)
  companyId        String    @db.VarChar(36)
  projectId        String?   @db.VarChar(36)
  status           String    @default("draft") @db.VarChar(32)
  terms            Json
  approvalId       String?   @db.VarChar(36)
  proposedByUserId String    @db.VarChar(191)
  proposedAt       DateTime  @default(now())
  expiresAt        DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectedReason   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([roleId, agentVersionId, status])
  @@index([companyId, status, updatedAt])
  @@index([agentVersionId])
  @@map("ai_direct_offers")
}

model aiDirectEmployments {
  id               String    @id @default(cuid())
  companyId        String    @db.VarChar(36)
  agentId          String    @db.VarChar(36)
  agentVersionId   String    @db.VarChar(36)
  roleId           String    @db.VarChar(36)
  projectId        String?   @db.VarChar(36)
  offerId          String    @db.VarChar(36)
  status           String    @default("candidate") @db.VarChar(32)
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status, updatedAt])
  @@index([agentId, status])
  @@index([agentVersionId])
  @@index([roleId])
  @@map("ai_direct_employments")
}

model aiDirectEmploymentEvents {
  id            String    @id @default(cuid())
  employmentId  String    @db.VarChar(36)
  sequence      Int
  fromStatus    String?   @db.VarChar(32)
  toStatus      String    @db.VarChar(32)
  actorUserId   String    @db.VarChar(191)
  reason        String?   @db.Text
  approvalId    String?   @db.VarChar(36)
  metadata      Json?
  occurredAt    DateTime  @default(now())

  @@unique([employmentId, sequence])
  @@index([employmentId, occurredAt])
  @@map("ai_direct_employment_events")
}

model aiDirectApprovals {
  id                  String    @id @default(cuid())
  organizationId      String?   @db.VarChar(36)
  targetType          String    @db.VarChar(64)
  targetId            String    @db.VarChar(191)
  requestedByUserId   String    @db.VarChar(191)
  approverUserId      String?   @db.VarChar(191)
  status              String    @default("pending") @db.VarChar(32)
  decision            String?   @db.VarChar(32)
  decisionReason     String?   @db.Text
  expiresAt           DateTime?
  decidedAt           DateTime?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([organizationId, status, updatedAt])
  @@index([targetType, targetId, status])
  @@index([approverUserId, status, updatedAt])
  @@map("ai_direct_approvals")
}

model aiDirectWorkflowRuns {
  id                      String    @id @default(cuid())
  organizationId          String?   @db.VarChar(36)
  employmentId            String?   @db.VarChar(36)
  agentVersionId          String?   @db.VarChar(36)
  workflowKey             String    @db.VarChar(128)
  workflowVersion         String?   @db.VarChar(64)
  status                  String    @default("queued") @db.VarChar(32)
  requestedByUserId       String    @db.VarChar(191)
  approvalId              String?   @db.VarChar(36)
  requestedModelPolicy    Json?
  resolvedModelCatalogId   String?   @db.VarChar(36)
  resolvedModelKey        String?   @db.VarChar(255)
  modelRunAuditIds        Json?
  inputSummary            Json?
  outputIndex             Json?
  tokenUsage              Json?
  costMicros              BigInt?
  latencyMs               Int?
  failureCode             String?   @db.VarChar(128)
  failureReason           String?   @db.Text
  metadata                Json?
  startedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([organizationId, createdAt])
  @@index([employmentId, createdAt])
  @@index([status, updatedAt])
  @@index([requestedByUserId, status, updatedAt])
  @@map("ai_direct_workflow_runs")
}

model aiDirectWorkflowRunSteps {
  id            String    @id @default(cuid())
  runId         String    @db.VarChar(36)
  stepKey       String    @db.VarChar(128)
  sequence      Int
  status        String    @default("pending") @db.VarChar(32)
  catalogModelId String?  @db.VarChar(36)
  modelKey      String?   @db.VarChar(255)
  inputTokens   Int?
  outputTokens  Int?
  costMicros    BigInt?
  latencyMs     Int?
  failureCode   String?   @db.VarChar(128)
  startedAt     DateTime?
  finishedAt    DateTime?
  outputSummary Json?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@unique([runId, sequence])
  @@index([runId, sequence])
  @@map("ai_direct_workflow_run_steps")
}
