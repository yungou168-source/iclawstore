{
  "name": "@clawhub/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "runtime:dispatch": "tsx src/outboxDispatcherProcess.ts",
    "runtime:audit-export": "NODE_OPTIONS='--max-old-space-size=128' tsx src/auditExportWorkerProcess.ts",
    "runtime:interview-retention-cleanup": "NODE_OPTIONS='--max-old-space-size=128' tsx src/interviewRetentionCleanupProcess.ts",
    "db:preflight:appearance": "tsx src/preflightAgentAppearanceMigration.ts",
    "db:push": "../node_modules/.bin/prisma db push --schema ../prisma/schema.prisma",
    "db:migrate": "../node_modules/.bin/prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:generate": "../node_modules/.bin/prisma generate --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@prisma/client": "^6.0.0",
    "convex": "^1.43.0",
    "fastify": "^5.0.0",
    "jose": "^6.2.7",
    "meilisearch": "^0.45.0",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
